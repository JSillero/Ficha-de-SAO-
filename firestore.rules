rules_version = '2';

// Reglas de Firestore de la ficha online (scripts/online/servicio.js).
// Se pegan en la consola de Firebase: Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }
    function sala(codigo) {
      return get(/databases/$(database)/documents/salas/$(codigo)).data;
    }
    // Miembro y no echado (al volver a entrar se quita la marca). Una sola lectura del documento de sala.
    function esMiembro(codigo) {
      let datos = sala(codigo);
      return conSesion() && request.auth.uid in datos.miembros
        && !(request.auth.uid in datos.get('expulsados', {}));
    }
    function esMaster(codigo) {
      return conSesion() && sala(codigo).master == request.auth.uid;
    }

    // Personajes: solo los ve y los toca su propietario
    match /personajes/{id} {
      allow read, delete: if conSesion() && resource.data.propietario == request.auth.uid;
      allow create: if conSesion()
        && request.resource.data.propietario == request.auth.uid
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000;
      allow update: if conSesion()
        && resource.data.propietario == request.auth.uid
        && request.resource.data.propietario == request.auth.uid
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000;
    }

    // Nombre público de cada jugador (para elegir a quién ofrecer algo)
    match /usuarios/{uid} {
      allow read: if conSesion();
      allow write: if conSesion() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() <= 40;
    }

    // Campos de la sala que pueden faltar en salas antiguas
    function personajesDe(datos) {
      return datos.get('personajes', {});
    }
    function expulsadosDe(datos) {
      return datos.get('expulsados', {});
    }
    // Personajes que han estado en la sala: registro.<uid>.<idPersonaje> = { nombre }
    function registroDe(datos) {
      return datos.get('registro', {});
    }

    // Jugador: entrar (añadirse a miembros y quitarse la marca de echado), y apuntar, renombrar o quitar
    // sus propios personajes conectados (personajes.<uid>.<pestaña>) y su registro (registro.<uid>). Nada más.
    function cambioDeJugador() {
      let uid = request.auth.uid;
      let antes = resource.data;
      let despues = request.resource.data;
      let cambioExpulsados = expulsadosDe(despues).diff(expulsadosDe(antes));
      return despues.diff(antes).affectedKeys().hasOnly(['miembros', 'personajes', 'expulsados', 'registro'])
        && registroDe(despues).diff(registroDe(antes)).affectedKeys().hasOnly([uid])
        && (!(uid in registroDe(despues)) || (registroDe(despues)[uid] is map && registroDe(despues)[uid].size() <= 100))
        && despues.miembros.hasAll(antes.miembros)
        && despues.miembros.removeAll(antes.miembros).hasOnly([uid])
        && uid in despues.miembros
        && personajesDe(despues).diff(personajesDe(antes)).affectedKeys().hasOnly([uid])
        && (!(uid in personajesDe(despues)) || (personajesDe(despues)[uid] is map && personajesDe(despues)[uid].size() <= 20))
        && cambioExpulsados.addedKeys().size() == 0
        && cambioExpulsados.changedKeys().size() == 0
        && cambioExpulsados.removedKeys().hasOnly([uid]);
    }

    // Máster: ocultar personajes, echar jugadores (marca y quita sus personajes), echar personajes del registro y
    // poner los suyos (personajes y registro, sin límite de entradas). No puede echarse a sí mismo.
    function cambioDeMaster() {
      let despues = request.resource.data;
      return resource.data.master == request.auth.uid
        && despues.diff(resource.data).affectedKeys().hasOnly(['ocultos', 'expulsados', 'personajes', 'registro', 'miembros'])
        && despues.miembros.hasAll(resource.data.miembros)
        && despues.get('ocultos', []) is list
        && despues.get('ocultos', []).size() <= 200
        && expulsadosDe(despues) is map
        && !(request.auth.uid in expulsadosDe(despues));
    }

    // Grupo, líder: invita, echa, pasa el liderazgo (a un integrante, con su uid) y actualiza su propia entrada
    function cambioDeLider() {
      let despues = request.resource.data;
      return resource.data.liderJugador == request.auth.uid
        && despues.diff(resource.data).affectedKeys().hasOnly(['invitados', 'miembros', 'lider', 'liderJugador', 'ultimo'])
        && despues.lider in despues.miembros
        && despues.miembros[despues.lider].jugador == despues.liderJugador;
    }

    // Grupo, integrante: solo su propia entrada de miembros (clave = "ultimo"): entrar si está invitado
    // (y se quita la invitación), actualizar su estado o salir
    function cambioDeIntegrante() {
      let antes = resource.data;
      let despues = request.resource.data;
      let clave = despues.ultimo;
      let invitados = despues.get('invitados', {}).diff(antes.get('invitados', {}));
      return despues.diff(antes).affectedKeys().hasOnly(['miembros', 'invitados', 'ultimo'])
        && clave is string
        && despues.miembros.diff(antes.miembros).affectedKeys().hasOnly([clave])
        && (clave in despues.miembros
          ? despues.miembros[clave].jugador == request.auth.uid
            && (clave in antes.miembros
              ? antes.miembros[clave].jugador == request.auth.uid
              : clave in antes.get('invitados', {}))
          : antes.miembros[clave].jugador == request.auth.uid)
        && invitados.addedKeys().size() == 0
        && invitados.changedKeys().size() == 0
        && invitados.removedKeys().hasOnly([clave]);
    }

    // Documento de estados/{idPersonaje}: solo estos campos, del propio jugador
    function estadoValido() {
      let d = request.resource.data;
      return d.jugador == request.auth.uid
        && d.keys().hasOnly(['jugador', 'master', 'nombre', 'vida', 'pa', 'nivel', 'iniciativa', 'estados', 'turno'])
        && d.master is string
        && d.nombre is string && d.nombre.size() <= 60
        && d.estados is list && d.estados.size() <= 30;
    }

    // Documento de fichas/{idPersonaje}: la ficha en JSON (como personajes/), del propio jugador
    function fichaValida() {
      let d = request.resource.data;
      return d.jugador == request.auth.uid
        && d.keys().hasOnly(['jugador', 'master', 'json', 'actualizado'])
        && d.master is string
        && d.json is string && d.json.size() < 900000
        && d.actualizado == request.time;
    }

    // Salas: se entra conociendo el código. Sin get() en estas reglas: todo sale de resource.data (gratis).
    match /salas/{codigo} {
      allow get: if conSesion();
      allow list: if conSesion() && request.auth.uid in resource.data.miembros;
      allow create: if conSesion()
        && request.resource.data.master == request.auth.uid
        && request.resource.data.miembros == [request.auth.uid]
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() <= 60
        && personajesDe(request.resource.data).size() == 0
        && expulsadosDe(request.resource.data).size() == 0
        && request.resource.data.get('ocultos', []).size() == 0;
      allow update: if conSesion() && (cambioDeJugador() || cambioDeMaster());
      allow delete: if conSesion() && resource.data.master == request.auth.uid;

      // Pop-ups compartidos (eventos.js). Cualquiera de la sala borra los de más de 24 h
      // (la ficha lo hace sola al entrar); el máster puede borrar cualquiera
      match /eventos/{evento} {
        allow read: if esMiembro(codigo);
        allow create: if esMiembro(codigo)
          && request.resource.data.jugador == request.auth.uid
          && request.resource.data.evento is string
          && request.resource.data.evento.size() < 20000
          && request.resource.data.creado == request.time;
        allow delete: if esMiembro(codigo)
          && (esMaster(codigo) || resource.data.creado < request.time - duration.value(24, 'h'));
      }

      // Grupos (hasta 6 personajes). Las claves de "miembros" son instancias (pestañas); cada entrada lleva el
      // uid de su jugador. Para ahorrar lecturas, solo crear hace get() de la sala: leer y escribir se basa en
      // el propio documento (el id del grupo es aleatorio y solo lo conocen sus integrantes e invitados).
      match /grupos/{grupo} {
        allow read: if conSesion();
        allow create: if esMiembro(codigo)
          && request.resource.data.liderJugador == request.auth.uid
          && request.resource.data.miembros.size() == 1
          && request.resource.data.lider in request.resource.data.miembros
          && request.resource.data.miembros[request.resource.data.lider].jugador == request.auth.uid
          && request.resource.data.get('invitados', {}).size() == 0;
        allow update: if conSesion()
          && request.resource.data.miembros.size() <= 6
          && (cambioDeLider() || cambioDeIntegrante());
        // Lo borra el líder (el último que queda siempre es el líder: el liderazgo pasa al salir)
        allow delete: if conSesion() && resource.data.liderJugador == request.auth.uid;
      }

      // Estado de cada personaje para la cabecera del máster (vida y PA en fracción, nivel, iniciativa, estados).
      // Lo escribe su jugador; lo lee y lo borra el máster que pone el documento. Sin get(): todo sale del documento.
      match /estados/{personaje} {
        allow read: if conSesion() && resource.data.master == request.auth.uid;
        allow create: if conSesion() && estadoValido();
        allow update: if conSesion() && resource.data.jugador == request.auth.uid && estadoValido();
        allow delete: if conSesion()
          && (resource.data.jugador == request.auth.uid || resource.data.master == request.auth.uid);
      }

      // Copia de la ficha completa para que el máster la vea en modo lectura. La escribe su jugador; la leen y la
      // borran el jugador y el máster que pone el documento. Leer una que no existe se permite (para saber que no hay).
      match /fichas/{personaje} {
        allow read: if conSesion()
          && (resource == null || resource.data.master == request.auth.uid || resource.data.jugador == request.auth.uid);
        allow create: if conSesion() && fichaValida();
        allow update: if conSesion() && resource.data.jugador == request.auth.uid && fichaValida();
        allow delete: if conSesion()
          && (resource.data.jugador == request.auth.uid || resource.data.master == request.auth.uid);
      }

      // Catálogo de artes compartido: lo añade cualquiera de la sala; lo edita su autor y lo borra su autor o el máster
      match /artes/{arte} {
        allow read: if esMiembro(codigo);
        allow create: if esMiembro(codigo)
          && request.resource.data.autor == request.auth.uid
          && request.resource.data.arte is string
          && request.resource.data.arte.size() < 50000;
        allow update: if esMiembro(codigo)
          && resource.data.autor == request.auth.uid
          && request.resource.data.autor == request.auth.uid
          && request.resource.data.arte is string
          && request.resource.data.arte.size() < 50000;
        allow delete: if esMiembro(codigo)
          && (resource.data.autor == request.auth.uid || esMaster(codigo));
      }
    }
  }
}
